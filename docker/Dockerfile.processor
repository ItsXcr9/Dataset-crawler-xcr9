# Multi-stage build for processor service
FROM python:3.11-slim as builder

# Install system dependencies for NLP libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install pybind11 for fasttext
RUN pip install --no-cache-dir pybind11

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download language detection model
RUN python -c "import fasttext; fasttext.load_model('https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin')"

# Production stage
FROM python:3.11-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /root/.cache /root/.cache
ENV PATH="/opt/venv/bin:$PATH"

# Create app directory
WORKDIR /app

# Copy application code
COPY processor/ ./processor/
COPY config/ ./config/

# Create non-root user
RUN useradd --create-home --shell /bin/bash processor && \
    chown -R processor:processor /app
USER processor

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["python", "-m", "processor.data_processor"]
